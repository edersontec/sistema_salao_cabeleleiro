<%- include('partials/header') %>

      <section class="secao contato-secao" id="contato">
        <div>
          <p class="eyebrow">CONVERSE COM A GENTE</p>
          <h2>Tem uma dúvida?</h2>
          <p class="muted">
            Envie uma mensagem e retornaremos assim que possível.
          </p>
        </div>

        <form id="contatoForm" class="contato-form">
          <label for="nome">Seu nome</label>
          <input
            type="text"
            id="nome"
            name="nome"
            required
            placeholder="Escreva seu nome"
          >

          <label for="email">Seu e-mail</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="seu@email.com"
          >

          <label for="mensagem">Mensagem</label>
          <textarea
            id="mensagem"
            name="mensagem"
            rows="3"
            required
            placeholder="Escreva sua mensagem..."
          ></textarea>

          <button class="botao" type="submit">
            Enviar mensagem
            <span aria-hidden="true">→</span>
          </button>
          <p id="mensagemContato" class="status" role="status"></p>
        </form>
      </section>

<%- include('partials/footer') %>
