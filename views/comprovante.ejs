<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/salao.css">
    <script src="/js/salao.js" defer></script>
    <title>Comprovante de Agendamento | Studio Maison</title>
  </head>
  <body>
    
    <header class="topo-pagina">
      <a class="marca" href="/">
        <span>SM</span>
        Studio Maison
      </a>
      <button class="tema-toggle" id="temaToggle" type="button" aria-label="Alternar tema"></button>
    </header>

    <main class="agendamento-container">
      <div id="resultado"></div>
    </main>

<script>

    function totalDosServicos(lista) {
        const precos = {
          Corte: 65,
          Barba: 45,
          Coloração: 90,
          'Coloração & tratamento': 90,
          'Escova / Hidratação': 70,
          Manicure: 50
        };
        return lista
          .split(',')
          .map((servico) => precos[servico.trim()] || 0)
          .reduce((total, preco) => total + preco, 0);
    }

    // ========================================================= 
    // RECUPERAÇÃO DOS DADOS SALVOS NO BANCO (enviados pelo servidor)
    // =========================================================
    const agendamentoDB = <%- JSON.stringify(agendamento) %>;

    // =========================================================
    // RECUPERAÇÃO DOS DADOS DO LOCALSTORAGE (fallback)
    // =========================================================

    // Recupera o nome do cliente. // || "Não informado" = usa "Não informado" caso não exista valor.
    let nomeCliente = agendamentoDB ? agendamentoDB.nome : (localStorage.getItem("nomeCliente") || "Não informado");
    let profissional = agendamentoDB ? agendamentoDB.profissional : (localStorage.getItem("profissional") || "Não informado");
    let sexoCliente = agendamentoDB ? agendamentoDB.sexo : (localStorage.getItem("sexoCliente") || "Não informado");
    let listaServicos = agendamentoDB ? JSON.parse(agendamentoDB.services || "[]").join(", ") : (localStorage.getItem("listaServicos") || "Nenhum");
    let dataAtendimento = localStorage.getItem("data") || "Não informada";
    let horarioAtendimento = agendamentoDB ? agendamentoDB.hora : (localStorage.getItem("horario") || "Não informado");

    // =========================================================
    // LOCALIZAÇÃO DA ÁREA DO COMPROVANTE
    // =========================================================

    let areaResultado = document.getElementById("resultado");
    // Localiza a div onde o comprovante será inserido.

    // =========================================================
    // CRIAÇÃO DO COMPROVANTE 
    // =========================================================

    // Insere o conteúdo dinâmico na tela do comprovante
    areaResultado.innerHTML = `
        <div class="comprovante">
            <h3 class="titulo-comprovante">
                COMPROVANTE DE AGENDAMENTO - SALÃO
            </h3>
            <hr>
            <!-- Exibe o nome do cliente e os demais dados -->
            <p><strong>Cliente:</strong> ${nomeCliente}</p>
            <p><strong>Profissional:</strong> ${profissional}</p>
            <p><strong>Sexo:</strong> ${sexoCliente}</p>
            <p><strong>Serviços:</strong> ${listaServicos}</p>
            <p><strong>Total:</strong> <span class="destaque-preco">R$ ${totalDosServicos(listaServicos).toFixed(2).replace('.', ',')}</span></p>
            <p><strong>Data do Atendimento:</strong> ${dataAtendimento}</p>
            <p><strong>Horário:</strong> ${horarioAtendimento}</p>

            <div class="comprovante-acoes">
                <button onclick="window.print()" class="botao botao-full">
                Imprimir Comprovante
                </button>
                <a href="/agendamento" class="link-voltar-agendamento">
                ← Novo Agendamento
                </a>
            </div>
            
        </div>
    `;
</script>

<%- include('partials/footer') %>
