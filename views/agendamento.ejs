<%- include('partials/header') %>

<fieldset> <!-- Área do formulário -->
    <legend><strong>DADOS DO AGENDAMENTO</strong></legend> <!-- Título do formulário -->

    <form onsubmit="cadastrarAgendamento(); return false;"> <!-- Executa a função -->

        <label><strong>Nome do Cliente:</strong></label><br> <!-- Nome -->
        <input type="text" id="nome" required><br><br> <!-- Campo nome -->

        <label><strong>Profissional Preferido:</strong></label><br> <!-- Profissional -->
        <select id="profissional"> <!-- Lista de profissionais -->
            <option value="Carlos (Cabeleireiro)">Carlos (Cabeleireiro)</option>
            <option value="Mariana (Cabeleireira)">Mariana (Cabeleireira)</option>
            <option value="Roberto (Barbeiro)">Roberto (Barbeiro)</option>
            <option value="Ana (Esteticista)">Ana (Esteticista)</option>
            <option value="Indiferente">Indiferente</option>
        </select><br><br>

        <label><strong>Sexo:</strong></label><br> <!-- Perfil -->
        <input type="radio" name="sexo" value="Masculino" required> Masculino
        <input type="radio" name="sexo" value="Feminino"> Feminino<br><br>
    

        <label><strong>Serviços Desejados:</strong></label><br> <!-- Serviços -->
        <input type="checkbox" class="serv" value="Corte"> Corte de Cabelo
        <input type="checkbox" class="serv" value="Barba"> Barba
        <input type="checkbox" class="serv" value="Coloração"> Coloração
        <input type="checkbox" class="serv" value="Escova / Hidratação"> Escova / Hidratação
        <input type="checkbox" class="serv" value="Manicure"> Manicure<br><br>

        <label><strong>Data do Atendimento:</strong></label><br> <!-- Data -->
        <input type="date" id="data" required><br><br> <!-- Campo data -->

        <label><strong>Horário:</strong></label><br> <!-- Horário -->
        <input type="time" id="horario" required><br><br> <!-- Campo horário -->

        <input class="botao" type="submit" value="CONFIRMAR AGENDAMENTO"> <!-- Confirma -->

    </form>
</fieldset>

<%- include('partials/footer') %>

