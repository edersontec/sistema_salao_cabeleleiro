<%- include('partials/header') %>

      <section class="secao servicos-secao" id="servicos">
        <div class="secao-cabecalho">
          <div>
            <p class="eyebrow">MENU DE SERVIÇOS</p>
            <h2>Nossos Serviços</h2>
          </div>
          <a class="link-seta" href="/agendamento">
            Ver disponibilidade →
          </a>
        </div>

        <div class="servicos-grid">
          <article class="servico-card destaque">
            <span class="numero">01</span>
            <div>
              <h3>Corte</h3>
              <p>Cortes personalizados baseados em visagismo para um visual único.</p>
              <strong>A partir de R$ 45</strong>
            </div>
          </article>

          <article class="servico-card">
            <span class="numero">02</span>
            <div>
              <h3>Barba</h3>
              <p>Modelagem, alinhamento de barba e cuidados com a pele.</p>
              <strong>A partir de R$ 65</strong>
            </div>
          </article>

          <article class="servico-card">
            <span class="numero">03</span>
            <div>
              <h3>Coloração & tratamento</h3>
              <p>Coloração completa, luzes e hidratação para todos os tipos de cabelo.</p>
              <strong>A partir de R$ 90</strong>
            </div>
          </article>
        </div>
      </section>

      <section class="secao agenda-secao" id="horarios">
        <div>
          <p class="eyebrow">PLANEJE SUA VISITA</p>
          <h2>
            Sua identidade,<br>
            <em>nossa arte.</em>
          </h2>
          <p class="muted">
            Atendimentos de terça a sábado. Reserve seu horário em poucos
            passos.
          </p>
          <a class="botao" href="/agendamento">
            Agendar agora
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <table class="tabela-horario">
          <caption>Horários de funcionamento</caption>
          <tbody>
            <tr>
              <th>Terça a sexta</th>
              <td>09:00 - 19:00</td>
            </tr>
            <tr>
              <th>Sábado</th>
              <td>09:00 - 17:00</td>
            </tr>
            <tr>
              <th>Domingo e segunda</th>
              <td>Fechado</td>
            </tr>
          </tbody>
        </table>
      </section>

<%- include('partials/footer') %>
