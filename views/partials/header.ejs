<!-- header.ejs -->

<!DOCTYPE html>
<html lang="pt-br">
<head>
  <!-- Define o conjunto de caracteres como UTF-8 (permite acentuação corretamente) -->
  <meta charset="UTF-8">
  <meta name="author" content="Wanderley Lopes Batista">     
  <meta name="viewport" content="width=device-width, initial-scale=1.0">    

  <!-- Define o título que aparece na aba do navegador -->
  <title><%= salaoNome %></title>

  <!-- Importa o arquivo CSS externo para estilizar a página -->
  <link rel="stylesheet" href="/css/salao.css">

  <!-- Carrega o JavaScript -->
  <script src="/js/salao.js"></script>

</head>
<body>

    <!-- Título principal da página -->
    <h2><%= salaoNome %></h2>

    <!-- Menu de navegação principal -->
  <ul class="menu">

    <!-- Link para a página home -->
    <li><a href="/">Home</a></li>

    <!-- Link para a página de agendamento -->
    <li><a href="/agendamento">Agendamento</a></li>

    <!-- Link fictício para serviços -->
    <li><a href="/servicos">Serviços</a></li>

    <!-- Link fictício para contato -->
    <li><a href="/contato">Contato</a></li>
	
  </ul>

  <!-- Banner com imagem externa (mantido o mesmo nome do arquivo) -->
  <img id="banner" 
       src="/imagem/banner.jpg"
       alt="Imagem do banner do Salão de Cabeleireiro">

  <!-- Caixa branca com conteúdo informativo principal -->
  <div style="background: white; padding: 20px; border-radius: 10px;">